# Frontend Environment Variables (Headless Architecture)

# ==================
# API Configuration
# ==================
# Backend API URL (Microservice)
VITE_API_BASE_URL=http://localhost:3001

# ==================
# Firebase Config (Optional)
# ==================
# Get from: https://console.firebase.google.com/ → Project Settings → Web App
# Note: Auth is now handled by backend API, these are for reference only
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# ==================
# Gemini API (Deprecated)
# ==================
# NOTE: Not used in frontend anymore - translation handled by backend
# VITE_GEMINI_API_KEY=removed
